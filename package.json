{
  "name": "vouchlab",
  "version": "1.0.0",
  "description": "TrustShare / VouchLab - Trust-and-Accountability Campus Resource Sharing",
  "homepage": "https://github.com/GitKrishna-source/VouchLab#readme",
  "bugs": {
    "url": "https://github.com/GitKrishna-source/VouchLab/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GitKrishna-source/VouchLab.git"
  },
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "server/src/index.js",
  "scripts": {
    "build": "npm install --prefix server && npm install --prefix client && npm run build --prefix client",
    "start": "node server/src/index.js",
    "server": "node server/src/index.js",
    "client": "npm run dev --prefix client",
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"node server/src/index.js\" \"npm run dev --prefix client\"",
    "seed": "node server/src/db/seed.js",
    "test": "node --test server/tests/*.test.js"
  },
  "dependencies": {
    "concurrently": "^9.2.5"
  }
}
